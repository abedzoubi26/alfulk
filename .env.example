# Copy to .env for local development. Never commit a real .env.
# Deployed environments inject these as real environment variables instead
# (ADR-0003); every environment generates its own values independently.

# Which settings module to load.
#   config.settings.local       developer machines
#   config.settings.test        test suite
#   config.settings.production  preview, staging and production
DJANGO_SETTINGS_MODULE=config.settings.local

# Django signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# HMAC key for one-time recovery codes. Must differ from SECRET_KEY.
# Rotating it invalidates every outstanding recovery code.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
RECOVERY_CODE_HMAC_KEY=

# Keys that encrypt TOTP secrets at rest (ADR-0005). Ordered, comma-separated
# `kid:base64key`; the first entry encrypts, any entry decrypts. 32 bytes each:
#   python -c "import base64,secrets; print('k1:'+base64.b64encode(secrets.token_bytes(32)).decode())"
# Lose this and every user loses their second factor: it belongs in key escrow,
# separately from the database backups it protects.
# Read by the settings module when E8 lands; declared here so every environment
# is provisioned with it from the start.
TOTP_SECRET_ENCRYPTION_KEYS=

# Reverse proxies whose X-Forwarded-For entries we trust, comma-separated CIDRs
# (ADR-0005). Deliberately empty here and in test: with no trusted proxy the
# client IP falls back to REMOTE_ADDR, so nothing ever trusts a client-supplied
# header by default. Deployed environments set their own proxy ranges.
TRUSTED_PROXY_CIDRS=

DATABASE_URL=postgres://alfulk:alfulk@localhost:5432/alfulk

# Comma-separated. Required by config.settings.production; ignored locally.
ALLOWED_HOSTS=
# Comma-separated, scheme included, e.g. https://staging.example.org
CSRF_TRUSTED_ORIGINS=

# HSTS. Deployed environments only; ignored locally. Ramp max-age per hostname
# (300 -> 86400 -> 31536000) so a first-deploy TLS fault cannot lock visitors
# out for a year. Leave the two flags false everywhere except production:
# `preload` applies to the registrable domain, not to one host, and takes
# months to reverse -- a preview host must never assert it.
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Idle session timeout, in seconds. Default is 30 minutes, per the increment 1
# brief. This is the idle window only -- the 12-hour absolute session lifetime
# is enforced separately and arrives with E5.
SESSION_COOKIE_AGE=1800

# Argon2id cost parameters. Defaults suit a 4 GB application host; raise them
# if sign-in latency allows. Raising them re-hashes each password on next
# successful sign-in.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Serves the template reference page at /_ui/forms, which renders the shared
# form partials in every state so the accessibility baseline can be checked in
# a browser. On for developer machines and preview environments; off for
# staging and production, which have no use for it.
UI_REFERENCE_ENABLED=false

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@localhost

LOG_LEVEL=INFO
